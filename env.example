TMDB_READ_ACCESS_TOKEN=
# Alternative to the read access token; backend only.
TMDB_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Optional alternate image origin; default is the official TMDB image URL.
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Password recovery: configure your own mail service. Never commit credentials.
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Verification and reset email: see ../EMAIL_SETUP.md.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USERNAME=resend
# SMTP_PASSWORD is your private Resend API key; SMTP_FROM must use your verified domain.
# Gmail test: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465; use your Gmail + app password.
# APP_PUBLIC_URL must match the actual public frontend address for emailed links.

# Django (active backend). FRAME uses DJANGO_DATABASE_URL; see ../POSTGRESQL.md.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production. Keep private. Local development generates an ignored key.
DJANGO_SECRET_KEY=
# Set your private PostgreSQL connection URL. Never put real credentials in this example.
# Example: postgresql://frame:YOUR_URL_SAFE_PASSWORD@127.0.0.1:55432/frame
# Managed providers may require ?sslmode=require.
# Blank uses SQLite only for a fresh development setup.
DJANGO_DATABASE_URL=
# DJANGO_SQLITE_PATH=/data/frame-django.sqlite3
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# Neon: neon deploy pulls DATABASE_URL and DATABASE_URL_UNPOOLED into root .env.local.
# Django reads them on the server. Existing DJANGO_DATABASE_URL remains a fallback.
# Do not copy database credentials into VITE_ variables.
